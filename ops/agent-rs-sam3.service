[Unit]
Description=Agent-RS CUDA image segmentation service
After=network.target

[Service]
Type=simple
User=agent-rs
Group=agent-rs
WorkingDirectory=/opt/agent-rs
EnvironmentFile=/etc/agent-rs/sam3.env
ExecStart=/opt/agent-rs/.venv-sam3/bin/python -m uvicorn ops.sam3_service:app --host 127.0.0.1 --port 18082 --no-access-log
Restart=on-failure
RestartSec=10
UMask=0007

[Install]
WantedBy=multi-user.target
